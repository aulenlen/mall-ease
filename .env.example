# =================================================================
# Mall-Ease 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# =================================================================

# Spring Profile 激活
SPRING_PROFILES_ACTIVE=cloud

# =================================================================
# Nacos 配置中心
# =================================================================
# 云服务器公网地址（请替换为你的实际地址）
NACOS_SERVER_ADDR=your_nacos_host:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# =================================================================
# TiDB Cloud 数据库配置
# =================================================================
# 从 TiDB Cloud Console 获取连接信息
# 格式: jdbc:mysql://<host>:<port>/<database>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_URL=jdbc:mysql://gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/mall_ease?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password

# =================================================================
# Redis 配置
# =================================================================
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# =================================================================
# Elasticsearch 配置
# =================================================================
ES_URIS=http://your_es_host:9200

# =================================================================
# 对象存储配置（支持 Cloudflare R2 / MinIO / 阿里云 OSS 等 S3 兼容存储）
# =================================================================
# Cloudflare R2 示例:
#   MINIO_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_URL=https://images.your-domain.com
# MinIO 示例:
#   MINIO_ENDPOINT=http://your_minio_host:9000
#   STORAGE_PUBLIC_URL=http://your_minio_host:9000/mall-ease
# 阿里云 OSS 示例:
#   MINIO_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   STORAGE_PUBLIC_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
MINIO_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
MINIO_BUCKET=mall-ease
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
STORAGE_PUBLIC_URL=https://images.your-domain.com

# =================================================================
# Sa-Token 密钥（生产环境请使用强随机字符串）
# =================================================================
SA_TOKEN_SECRET=your-strong-secret-key-at-least-32-characters