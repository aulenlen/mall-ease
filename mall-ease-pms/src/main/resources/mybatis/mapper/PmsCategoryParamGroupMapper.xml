<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallease.pms.dao.PmsCategoryParamGroupDao">

    <resultMap id="BaseResultMap" type="com.mallease.pms.pojo.PmsCategoryParamGroup">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="category_id" property="categoryId" jdbcType="BIGINT"/>
        <result column="param_group_id" property="paramGroupId" jdbcType="BIGINT"/>
        <result column="sort" property="sort" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, category_id, param_group_id, sort, create_time
    </sql>

    <!-- 根据分类ID查询 -->
    <select id="selectByCategoryId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pms_category_param_group
        WHERE category_id = #{categoryId,jdbcType=BIGINT}
        ORDER BY sort, id
    </select>

    <!-- 根据参数组ID查询 -->
    <select id="selectByParamGroupId" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pms_category_param_group
        WHERE param_group_id = #{paramGroupId,jdbcType=BIGINT}
    </select>

    <!-- 检查关联是否存在 -->
    <select id="selectByCategoryIdAndParamGroupId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM pms_category_param_group
        WHERE category_id = #{categoryId,jdbcType=BIGINT}
          AND param_group_id = #{paramGroupId,jdbcType=BIGINT}
    </select>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.mallease.pms.pojo.PmsCategoryParamGroup" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pms_category_param_group (
            category_id, param_group_id, sort
        ) VALUES (
            #{categoryId,jdbcType=BIGINT}, #{paramGroupId,jdbcType=BIGINT}, #{sort,jdbcType=INTEGER}
        )
    </insert>

    <!-- 批量插入 -->
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO pms_category_param_group (
            category_id, param_group_id, sort
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.categoryId,jdbcType=BIGINT}, #{item.paramGroupId,jdbcType=BIGINT},
                #{item.sort,jdbcType=INTEGER}
            )
        </foreach>
    </insert>

    <!-- 根据参数组ID删除 -->
    <delete id="deleteByParamGroupId" parameterType="java.lang.Long">
        DELETE FROM pms_category_param_group
        WHERE param_group_id = #{paramGroupId,jdbcType=BIGINT}
    </delete>


    <!-- 根据分类ID和参数组ID列表批量删除 -->
    <delete id="deleteByCategoryIdAndParamGroupIds">
        DELETE FROM pms_category_param_group
        WHERE category_id = #{categoryId,jdbcType=BIGINT}
          AND param_group_id IN
        <foreach collection="paramGroupIds" item="paramGroupId" open="(" separator="," close=")">
            #{paramGroupId,jdbcType=BIGINT}
        </foreach>
    </delete>

    <!-- 根据参数组ID列表批量删除 -->
    <delete id="deleteByParamGroupIds">
        DELETE FROM pms_category_param_group
        WHERE param_group_id IN
        <foreach collection="paramGroupIds" item="paramGroupId" open="(" separator="," close=")">
            #{paramGroupId,jdbcType=BIGINT}
        </foreach>
    </delete>

</mapper>
