<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallease.content.dal.mapper.ArticleSpuRelationDao">
    <resultMap id="BaseResultMap" type="com.mallease.content.dal.entity.ArticleSpuRelation">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="article_id" property="articleId" jdbcType="BIGINT"/>
        <result column="spu_id" property="spuId" jdbcType="BIGINT"/>
        <result column="sort" property="sort" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, article_id, spu_id, sort, create_time
    </sql>

    <select id="selectByArticleId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from content_article_spu_relation
        where article_id = #{articleId,jdbcType=BIGINT}
        order by sort asc
    </select>

    <select id="selectByArticleIds" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from content_article_spu_relation
        where article_id in
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId,jdbcType=BIGINT}
        </foreach>
        order by article_id, sort asc
    </select>

    <delete id="deleteByArticleId">
        delete from content_article_spu_relation
        where article_id = #{articleId,jdbcType=BIGINT}
    </delete>

    <delete id="deleteByArticleIds">
        delete from content_article_spu_relation
        where article_id in
        <foreach collection="articleIds" item="articleId" open="(" separator="," close=")">
            #{articleId,jdbcType=BIGINT}
        </foreach>
    </delete>

    <insert id="insertBatch" parameterType="java.util.List">
        insert into content_article_spu_relation (article_id, spu_id, sort, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.articleId,jdbcType=BIGINT}, #{item.spuId,jdbcType=BIGINT},
             #{item.sort,jdbcType=INTEGER}, #{item.createTime,jdbcType=TIMESTAMP})
        </foreach>
    </insert>

    <delete id="deleteByArticleIdAndSpuIds">
        delete from content_article_spu_relation
        where article_id = #{articleId,jdbcType=BIGINT}
          and spu_id in
        <foreach collection="spuIds" item="spuId" open="(" separator="," close=")">
            #{spuId,jdbcType=BIGINT}
        </foreach>
    </delete>
</mapper>
