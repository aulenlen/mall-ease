<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mallease.trade.dao.PaymentOrderDao">

    <resultMap id="BaseResultMap" type="com.mallease.trade.model.data.entity.PaymentOrder">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="payment_no" property="paymentNo" jdbcType="VARCHAR"/>
        <result column="order_no" property="orderNo" jdbcType="VARCHAR"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="pay_amount" property="payAmount" jdbcType="DECIMAL"/>
        <result column="pay_channel" property="payChannel" jdbcType="TINYINT"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="third_trade_no" property="thirdTradeNo" jdbcType="VARCHAR"/>
        <result column="third_buyer_id" property="thirdBuyerId" jdbcType="VARCHAR"/>
        <result column="expire_time" property="expireTime" jdbcType="TIMESTAMP"/>
        <result column="paid_time" property="paidTime" jdbcType="TIMESTAMP"/>
        <result column="notify_time" property="notifyTime" jdbcType="TIMESTAMP"/>
        <result column="notify_count" property="notifyCount" jdbcType="INTEGER"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, payment_no, order_no, user_id, pay_amount, pay_channel,
        status, third_trade_no, third_buyer_id, expire_time, paid_time,
        notify_time, notify_count, remark, create_time, update_time
    </sql>

    <!-- 插入支付单 -->
    <insert id="insert" parameterType="com.mallease.trade.model.data.entity.PaymentOrder"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO trade_payment_order (
            payment_no, order_no, user_id, pay_amount, pay_channel,
            status, expire_time, remark
        ) VALUES (
            #{paymentNo,jdbcType=VARCHAR}, #{orderNo,jdbcType=VARCHAR},
            #{userId,jdbcType=BIGINT}, #{payAmount,jdbcType=DECIMAL},
            #{payChannel,jdbcType=TINYINT}, #{status,jdbcType=TINYINT},
            #{expireTime,jdbcType=TIMESTAMP}, #{remark,jdbcType=VARCHAR}
        )
    </insert>

    <!-- 根据支付单号查询 -->
    <select id="selectByPaymentNo" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM trade_payment_order
        WHERE payment_no = #{paymentNo,jdbcType=VARCHAR}
    </select>

    <!-- 根据订单号查询 -->
    <select id="selectByOrderNo" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM trade_payment_order
        WHERE order_no = #{orderNo,jdbcType=VARCHAR}
    </select>

    <!-- 更新支付状态（仅待支付状态可更新，CAS 防并发） -->
    <update id="updateStatus">
        UPDATE trade_payment_order
        SET status = #{status,jdbcType=TINYINT},
            paid_time = #{paidTime,jdbcType=TIMESTAMP},
            third_trade_no = #{thirdTradeNo,jdbcType=VARCHAR},
            update_time = NOW()
        WHERE id = #{id,jdbcType=BIGINT}
          AND status = 1
    </update>

    <!-- 根据订单号关闭支付单（仅待支付状态可关闭） -->
    <update id="closeByOrderNo">
        UPDATE trade_payment_order
        SET status = #{status,jdbcType=TINYINT},
            update_time = NOW()
        WHERE order_no = #{orderNo,jdbcType=VARCHAR}
          AND status = 1
    </update>

</mapper>
